      "id": "c1c2c3d4-0003-4000-8000-000000000002",
      "name": "Read Processed Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        300,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "XU9BVy1MqW6lCLNl",
          "name": "Google Sheets OAuth2"
        }
      },
      "notes": "No status filter here on purpose — see 'Filter Ready For Classification' next. Filtering only on status=email_found was a bug: it meant no-website leads (which stage 2 leaves at status=no_email, since there's nothing for it to find) never reached this workflow at all, and the 'Handle No Website' branch below was dead code."
    },
    {
      "parameters": {
        "jsCode": "// Only process leads that finished stage 2 (email_found or no_email) and\n// exclude anything not yet processed (status='scraped') or already classified\n// by a previous run of this workflow (analyzed/not_pitchable/inconclusive/etc) —\n// re-reading the whole sheet without this would silently re-screenshot and\n// re-bill leads that were already classified.\nconst items = $input.all();\nconst readyStatuses = new Set(['email_found', 'no_email']);\nreturn items.filter(item => readyStatuses.has(item.json.status));\n"
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000017",
      "name": "Filter Ready For Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-has-website-03",
              "leftValue": "={{ $json.website }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000000",
      "name": "Has Website?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "notes": "No website is an automatic weak verdict — nothing to screenshot or analyze, and it's the primary signal this campaign targets."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-has-email-found-03",
              "leftValue": "={{ $json.status }}",
              "rightValue": "email_found",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000018",
      "name": "Has Email Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        220
      ],
      "notes": "Has a website but stage 2 never found an email (status still no_email). Nothing to send to even if we classify it, so skip screenshot/OpenAI entirely rather than spend the API calls."
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Read Processed Leads').item.json;\nreturn [{\n  json: {\n    ...lead,\n    verdict: '',\n    confidence: '',\n    reasoning: '',\n    weak_reason: ''\n  }\n}];"
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000019",
      "name": "Skip — No Email Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        420
      ],
      "notes": "Has a website but no email (both scrape and Hunter came up empty in stage 2). Left unclassified — status stays no_email — rather than spending a screenshot/OpenAI call on a lead nothing can currently be sent to."
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Read Processed Leads').item.json;\nreturn [{\n  json: {\n    ...lead,\n    status: 'analyzed',\n    verdict: 'weak',\n    confidence: 'high',\n    reasoning: 'Business has no website at all.',\n    weak_reason: 'no website'\n  }\n}];"
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000016",
      "name": "Handle No Website",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        560
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.website }}",
        "options": {
          "timeout": 15000,
          "allowUnauthorizedCerts": true,
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 3
            }
          }
        }
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000003",
      "name": "Check Website Alive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        260
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-alive",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000004",
      "name": "Alive?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        920,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Read Processed Leads').item.json;\nreturn [{\n  json: {\n    ...lead,\n    status: 'dead_site',\n    verdict: 'inconclusive',\n    confidence: 'low',\n    reasoning: 'Website did not respond or is unreachable.',\n    weak_reason: ''\n  }\n}];"
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000005",
      "name": "Handle Dead Site",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        480
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.screenshotone.com/take?access_key={{$env.SCREENSHOTONE_API_KEY}}&url={{encodeURIComponent($('Read Processed Leads').item.json.website)}}&viewport_width=1280&viewport_height=900&format=png&full_page=false&block_ads=true&response_type=base64",
        "options": {
          "timeout": 45000
        }
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000006",
      "name": "Take Screenshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        220
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-screenshot-error",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000007",
      "name": "Screenshot Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1360,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Read Processed Leads').item.json;\nconsole.error(\"Screenshot error for \" + lead.website, $input.item.json);\nreturn [{\n  json: {\n    ...lead,\n    status: 'screenshot_failed',\n    verdict: 'inconclusive',\n    confidence: 'low',\n    reasoning: 'Screenshot capture failed.',\n    weak_reason: ''\n  }\n}];"
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000008",
      "name": "Handle Screenshot Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\n// 1. Get Base64 image\nconst base64Image = typeof $input.item.json === 'string' ? $input.item.json : ($input.item.json.data || $input.item.json.body || $input.item.json.base64);\n\n// 2. Load prompt\nconst workspaceDir = process.cwd();\nconst promptPath = path.join(workspaceDir, 'prompts', 'website_analysis.txt');\nconst prompt = fs.readFileSync(promptPath, 'utf8');\n\n// 3. Build body — JSON mode, matches the verdict/confidence/reasoning/weak_reason schema\nconst body = {\n    model: \"gpt-4o-mini\",\n    messages: [\n        {\n            role: \"user\",\n            content: [\n                { type: \"text\", text: prompt },\n                { type: \"image_url\", image_url: { url: \"data:image/png;base64,\" + base64Image } }\n            ]\n        }\n    ],\n    response_format: { type: \"json_object\" },\n    temperature: 0.4,\n    max_tokens: 2048\n};\n\nreturn [{ json: body }];"
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000009",
      "name": "Build OpenAI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000,
          "bodyContentType": "json"
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            }
          ]
        }
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000010",
      "name": "OpenAI Vision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1840,
        180
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-openai-error",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000011",
      "name": "OpenAI Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2060,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Read Processed Leads').item.json;\nconsole.error(\"OpenAI Vision error for \" + lead.website, $input.item.json);\nreturn [{\n  json: {\n    ...lead,\n    status: 'analysis_failed',\n    verdict: 'inconclusive',\n    confidence: 'low',\n    reasoning: 'OpenAI vision call failed.',\n    weak_reason: ''\n  }\n}];"
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000012",
      "name": "Handle OpenAI Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Read Processed Leads').item.json;\nconst result = $input.item.json;\nlet text = '';\n\ntry {\n  text = result.choices[0].message.content.trim();\n} catch (e) {\n  return [{\n    json: {\n      ...lead,\n      status: 'analysis_failed',\n      verdict: 'inconclusive',\n      confidence: 'low',\n      reasoning: 'OpenAI response had no content to parse.',\n      weak_reason: ''\n    }\n  }];\n}\n\n// Strip markdown code fences if the model added them despite json_object mode\nif (text.startsWith('```json')) text = text.substring(7);\nelse if (text.startsWith('```')) text = text.substring(3);\nif (text.endsWith('```')) text = text.substring(0, text.length - 3);\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text.trim());\n} catch (e) {\n  return [{\n    json: {\n      ...lead,\n      status: 'analysis_failed',\n      verdict: 'inconclusive',\n      confidence: 'low',\n      reasoning: 'Could not parse OpenAI output as JSON: ' + text.substring(0, 200),\n      weak_reason: ''\n    }\n  }];\n}\n\nconst verdict = parsed.verdict || 'inconclusive';\nconst statusMap = { weak: 'analyzed', strong: 'not_pitchable', inconclusive: 'inconclusive' };\n\nreturn [{\n  json: {\n    ...lead,\n    verdict: verdict,\n    confidence: parsed.confidence || 'low',\n    reasoning: parsed.reasoning || '',\n    weak_reason: parsed.weak_reason || '',\n    status: statusMap[verdict] || 'inconclusive'\n  }\n}];"
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000013",
      "name": "Extract Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        100
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.GOOGLE_SHEET_ID}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "={{ $json.status }}",
            "verdict": "={{ $json.verdict }}",
            "confidence": "={{ $json.confidence }}",
            "reasoning": "={{ $json.reasoning }}",
            "weak_reason": "={{ $json.weak_reason }}"
          },
          "matchingColumns": [
            "name"
          ],
          "schema": [
            {
              "id": "name",
              "displayName": "name",
              "required": true,
              "defaultMatch": true
            },
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false
            },
            {
              "id": "verdict",
              "displayName": "verdict",
              "required": false,
              "defaultMatch": false
            },
            {
              "id": "confidence",
              "displayName": "confidence",
              "required": false,
              "defaultMatch": false
            },
            {
              "id": "reasoning",
              "displayName": "reasoning",
              "required": false,
              "defaultMatch": false
            },
            {
              "id": "weak_reason",
              "displayName": "weak_reason",
              "required": false,
              "defaultMatch": false
            }
          ]
        },
        "options": {}
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000014",
      "name": "Update Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2520,
        240
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "XU9BVy1MqW6lCLNl",
          "name": "Google Sheets OAuth2"
        }
      },
      "notes": "Sheet 'Leads' tab needs columns: status, verdict, confidence, reasoning, weak_reason (in addition to the columns from workflows 01/02)."
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet weak = 0, strong = 0, inconclusive = 0, dead = 0, screenshot_fail = 0, analysis_fail = 0;\n\nfor (const item of items) {\n  const v = item.json.verdict;\n  const s = item.json.status;\n  if (s === 'dead_site') dead++;\n  else if (s === 'screenshot_failed') screenshot_fail++;\n  else if (s === 'analysis_failed') analysis_fail++;\n  else if (v === 'weak') weak++;\n  else if (v === 'strong') strong++;\n  else inconclusive++;\n}\n\nreturn [{\n  json: {\n    message: '✅ Website classification complete.',\n    weak_pitchable: weak,\n    strong_skip: strong,\n    inconclusive: inconclusive,\n    dead_sites: dead,\n    screenshot_failures: screenshot_fail,\n    analysis_failures: analysis_fail,\n    total: items.length\n  }\n}];"
      },
      "id": "c1c2c3d4-0003-4000-8000-000000000015",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2760,
        240
      ]
    }
  ],
